# Google AI Studio에서 발급: https://aistudio.google.com/apikey
# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here

# 공유 링크 웹 페이지 (Firebase Hosting)
EXPO_PUBLIC_SHARE_BASE_URL=https://regret-wallet-3db60.web.app

# (선택) EAS 원격 푸시 — `npx eas init` 후 project UUID
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
