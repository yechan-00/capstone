{
  "name": "regret-wallet",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "prestart": "node scripts/ensure-ascii-path.mjs",
    "start": "bash scripts/start-expo.sh",
    "stop": "bash scripts/stop-expo.sh",
    "start:tunnel": "bash scripts/start-expo-tunnel.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p workers/tsconfig.json",
    "r2:create": "wrangler r2 bucket create regret-wallet-images",
    "r2:dev": "wrangler dev",
    "r2:deploy": "wrangler deploy",
    "r2:check": "node scripts/check-r2-image-api.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/native": "^7.1.8",
    "date-fns": "^3.6.0",
    "expo": "^57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.8.0",
    "jose": "^6.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-mobile-picker": "^1.2.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/react": "~19.2.4",
    "patch-package": "^8.0.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.133.0"
  },
  "private": true
}
