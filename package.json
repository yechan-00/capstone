{
  "name": "regret-wallet",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "prestart": "node scripts/ensure-ascii-path.mjs",
    "start": "bash scripts/start-expo.sh",
    "stop": "bash scripts/stop-expo.sh",
    "start:tunnel": "bash scripts/start-expo-tunnel.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p workers/tsconfig.json",
    "r2:create": "wrangler r2 bucket create regret-wallet-images",
    "r2:dev": "wrangler dev",
    "r2:deploy": "wrangler deploy",
    "r2:check": "node scripts/check-r2-image-api.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "^7.1.8",
    "date-fns": "^3.6.0",
    "expo": "^58.0.0",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.8.0",
    "jose": "^6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-mobile-picker": "^1.2.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.133.0"
  },
  "private": true
}
